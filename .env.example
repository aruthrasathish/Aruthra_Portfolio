# Contact form delivery (app/api/contact/route.js).
# Until RESEND_API_KEY and CONTACT_FROM_EMAIL are set, the form returns a clear
# "not configured yet" message instead of pretending the email was sent.

# https://resend.com/api-keys
RESEND_API_KEY=

# A verified sender on your Resend domain, e.g. "Portfolio <hello@yourdomain.com>"
CONTACT_FROM_EMAIL=

# Optional. Defaults to the address in lib/data.js.
CONTACT_TO_EMAIL=
